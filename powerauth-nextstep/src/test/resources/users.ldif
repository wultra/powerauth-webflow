dn: dc=example,dc=com
objectClass: top
objectClass: domain
dc: example

dn: ou=people,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: people

# service account for the search step
dn: cn=svc_ldap_search,dc=example,dc=com
objectClass: simpleSecurityObject
objectClass: organizationalRole
cn: svc_ldap_search
userPassword: serviceSecret

# user that should authenticate successfully
dn: uid=test_user_ldap_1,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: test_user_ldap_1
sn: Alice
cn: Alice
userPassword: correct-password


# user for incorrect password (attribute-only check; embedded DS won't enforce it)
dn: uid=test_user_ldap_2,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: test_user_ldap_2
sn: Carol
cn: Carol
userPassword: whatever

# user for incorrect password with metadata (attribute-only check; embedded DS won't enforce it)
dn: uid=test_user_ldap_3,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: test_user_ldap_3
sn: Carol
cn: Carol
userPassword: whatever
passwordRetryCount: 2
nsAccountLock: true

# user for incorrect password with unexpected metadata (attribute-only check; embedded DS won't enforce it)
dn: uid=test_user_ldap_4,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: test_user_ldap_4
sn: Carol
cn: Carol
userPassword: whatever
passwordRetryCount: x
nsAccountLock: NO